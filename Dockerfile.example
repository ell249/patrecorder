FROM python:3.12-slim

LABEL maintainer="Elliot Alfirevich <elliot@skyteq.com.au>"

ENV TZ=Australia/Perth \
    FLASK_APP=app.py \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# WeasyPrint system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        libcairo2 \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libpangoft2-1.0-0 \
        libgdk-pixbuf2.0-0 \
        libffi8 \
        shared-mime-info \
        fonts-recommended \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies in a separate layer for cache efficiency
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# App source — config.py and static/uploads/ are excluded and mounted at runtime
COPY app.py config.example.py models.py utils.py views.py setup.py ./
COPY migrations/ ./migrations/
COPY templates/  ./templates/
COPY static/css/         ./static/css/
COPY static/swms.html static/swms_repair.html ./static/

# Placeholder upload directories — the real directory is bind-mounted at runtime
RUN mkdir -p static/uploads/tests static/uploads/repairs

EXPOSE 5090

CMD ["flask", "run", "--host=0.0.0.0", "--port=5090"]
